# Spectra KWS — .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
env/

# ML artifacts (too large for Git)
checkpoints/
*.pt
*.pth
*.onnx
*.tflite
runs/
logs/
tensorboard/

# Dataset audio files (large — use external storage)
dataset/positives/*.wav
dataset/negatives/*.wav
dataset/negatives/**/*.wav
dataset/confusion/*.wav
dataset/background/*.wav
!dataset/.gitkeep

# Generated C header (regenerated by export_tflite.py)
firmware/models/spectra_model.h
!firmware/models/spectra_model.h  # keep placeholder

# ESP-IDF build artifacts
firmware/build/
firmware/sdkconfig
firmware/sdkconfig.old
firmware/managed_components/
firmware/dependencies.lock
firmware/*.bin

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
